# ==============================================================================
# HOBERG DIGITAL NEWSROOM — ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to .env when running the Node.js server (npm start).
# Do NOT commit your real .env file to Git.
#
# Note: When publishing directly from your iPhone on GitHub Pages
# (https://hoberg.com.ng/blog/admin), you authenticate via the encrypted
# client-side PBKDF2 + AES-256-GCM GitHub PAT Vault and do not need a server .env.

# Server Port (default: 3000)
PORT=3000

# Administrator Secret for Node.js Server API Mode (/api/blog/*)
# Must be at least 12 characters. No default credentials exist.
HOBERG_ADMIN_SECRET=

# Optional pre-hashed scrypt password (format: <hex-salt>:<hex-scrypt-64>)
HOBERG_ADMIN_PASSWORD_HASH=

# Session HMAC signing secret (32+ random hex characters recommended)
HOBERG_SESSION_SECRET=

# IndexNow Key (matches /4f8b92e1c7d34a6085e2b190f3c6d8a4.txt)
INDEXNOW_KEY=4f8b92e1c7d34a6085e2b190f3c6d8a4
